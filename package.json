{
  "name": "anakin",
  "displayName": "Anakin: Web Data MCP Server",
  "description": "Adds the hosted Anakin MCP server (mcp.anakin.io) to agent mode: scrape, crawl, search and research the web. Sign in with OAuth, no API key to paste.",
  "version": "0.1.0",
  "publisher": "anakin",
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "homepage": "https://anakin.io/docs/integrations/ide-plugins/mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anakin-Inc/vscode-anakin"
  },
  "bugs": {
    "url": "https://github.com/Anakin-Inc/vscode-anakin/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "web scraping",
    "crawler",
    "web search"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "anakin",
        "label": "Anakin"
      }
    ],
    "configuration": {
      "title": "Anakin",
      "properties": {
        "anakin.serverUrl": {
          "type": "string",
          "default": "https://mcp.anakin.io/mcp",
          "scope": "machine",
          "markdownDescription": "URL of the Anakin MCP server. Keep the default unless you run your own Anakin MCP server. Must use `https://` (`http://` is accepted only for `localhost`)."
        }
      }
    },
    "commands": [
      {
        "command": "anakin.showSetup",
        "title": "Show Setup Instructions",
        "category": "Anakin"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "tsc -p ./ --noEmit && tsc -p ./test-fixture --noEmit",
    "test": "vitest run",
    "test:integration": "npm run compile && tsc -p ./test-fixture && node ./test-fixture/out/runTest.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.0",
    "@types/vscode": "1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "mocha": "^12.0.3",
    "ovsx": "^0.10.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
